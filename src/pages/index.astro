  {/* Conteo de las cifras de Experiencia (overhaul 2026-10-05): el HTML publica el numero
      real; aqui se lleva de 0 al valor cuando la banda entra en pantalla, en el mismo
      instante en que se revela. No corre con prefers-reduced-motion: la cifra queda
      visible tal cual. Sin JS, la cifra tambien queda visible. */}
  <script>
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bandas = document.querySelectorAll('[data-cifras]');
    if (!reducir && bandas.length > 0) {
      const nodosDe = (banda: Element) => Array.from(banda.querySelectorAll<HTMLElement>('[data-cifra]'));
      for (const banda of bandas) for (const nodo of nodosDe(banda)) nodo.textContent = '0';
      const observa = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            const banda = entrada.target;
            observa.unobserve(banda);
            banda.classList.add('cifras-visible');
            for (const nodo of nodosDe(banda)) {
              const fin = Number(nodo.dataset.cifra);
              if (!Number.isFinite(fin)) continue;
              const arranque = performance.now();
              const paso = (ahora: number) => {
                const avance = Math.min(1, (ahora - arranque) / 900);
                const suave = 1 - Math.pow(1 - avance, 3);
                nodo.textContent = String(Math.round(fin * suave));
                if (avance < 1) requestAnimationFrame(paso);
              };
              requestAnimationFrame(paso);
            }
          }
        },
        { threshold: 0.3 },
      );
      for (const banda of bandas) observa.observe(banda);
    }
  </script>

  {/* Reels (docs/35): mejora progresiva. El HTML ya trae `<video controls>` (usable sin JS
      y con prefers-reduced-motion). (1) Se cambian los controles nativos por el boton de la
      marca; al pulsarlo vuelven los controles y el video suena (el audio va a peticion:
      ningun navegador autoarranca con sonido). (2) La pasarela de movil mueve el carril de a
      UNA tarjeta y apaga los botones en los topes; el arrastre a mano ya funciona por CSS. */}
  <script>
    for (const caja of document.querySelectorAll<HTMLElement>('[data-reel]')) {
      const video = caja.querySelector('video');
      const boton = caja.querySelector('[data-reel-play]');
      if (!video || !boton) continue;
      video.controls = false;
      caja.classList.add('reel-listo');
      boton.addEventListener('click', () => {
        caja.classList.remove('reel-listo');
        video.controls = true;
        void video.play();
      });
    }

    const suave = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    for (const pasarela of document.querySelectorAll<HTMLElement>('[data-pasarela]')) {
      const carril = pasarela.querySelector<HTMLElement>('[data-reels]');
      const prev = pasarela.querySelector<HTMLButtonElement>('[data-reels-prev]');
      const next = pasarela.querySelector<HTMLButtonElement>('[data-reels-next]');
      if (!carril || !prev || !next) continue;
      // El paso es la distancia real entre dos tarjetas (ancho + hueco), medida del DOM: si
      // cambia el `gap` o el ancho, el boton sigue saltando exactamente una tarjeta.
      const paso = () => {
        const a = carril.children[0];
        const b = carril.children[1];
        return a && b
          ? b.getBoundingClientRect().left - a.getBoundingClientRect().left
          : carril.clientWidth;
      };
      const mover = (dir: number) => carril.scrollBy({ left: dir * paso(), behavior: suave });
      prev.addEventListener('click', () => mover(-1));
      next.addEventListener('click', () => mover(1));
      const topes = () => {
        const max = carril.scrollWidth - carril.clientWidth;
        prev.disabled = carril.scrollLeft <= 1;
        next.disabled = carril.scrollLeft >= max - 1;
      };
      carril.addEventListener('scroll', topes, { passive: true });
      addEventListener('resize', topes);
      topes();
    }
  </script>

